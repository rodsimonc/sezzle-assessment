flowchart LR
  subgraph build["Build stages in one Dockerfile, context is the repo root"]
    direction TB
    web["Stage web: node:22.23.2-alpine3.23<br/>npm ci for the frontend workspace<br/>npm run build gives frontend/dist"]:::stage
    api["Stage api: golang:1.27.2-alpine3.23<br/>CGO_ENABLED=0, -trimpath, -ldflags -s -w<br/>gives /out/server"]:::stage
  end

  subgraph image["Runtime image: distroless static-debian13 nonroot, under 40 MB"]
    direction TB
    bin["/app/server"]:::artifact
    dist["/app/web"]:::artifact
  end

  subgraph container["Running container"]
    direction TB
    proc["Process /app/server<br/>user 65532, exec-form ENTRYPOINT<br/>read-only root, no-new-privileges"]:::run
    env["Environment<br/>PORT=8080, STATIC_DIR=/app/web<br/>LOG_LEVEL, LOG_FORMAT, RATE_LIMIT_PER_MINUTE,<br/>RATE_LIMIT_BURST, TRUST_PROXY, CORS_ALLOWED_ORIGINS"]:::config
    hc["HEALTHCHECK every 10s<br/>/app/server -healthcheck calls /healthz"]:::run
    env --> proc
    hc -.-> proc
  end

  host["Host<br/>port 8080 maps to 8080"]:::host

  web -->|"dist"| dist
  api -->|"binary"| bin
  bin --> proc
  dist --> proc
  host --> proc

  classDef stage fill:#dbeafe,stroke:#2563eb,color:#111827
  classDef artifact fill:#e0e7ff,stroke:#4f46e5,color:#111827
  classDef run fill:#dcfce7,stroke:#16a34a,color:#111827
  classDef config fill:#fef3c7,stroke:#d97706,color:#111827
  classDef host fill:#f3f4f6,stroke:#6b7280,color:#111827
  style build fill:#ffffff,stroke:#2563eb,color:#111827
  style image fill:#ffffff,stroke:#4f46e5,color:#111827
  style container fill:#ffffff,stroke:#16a34a,color:#111827
