# Settings the backend reads from the environment. Copy this file to .env to change them.
# docker compose reads .env on its own. For `npm run dev` or `npm start`, export the values in your shell.
# Every line shows the default. A variable you leave out gets that default.

# TCP port the service listens on. Docker pins it to 8080 inside the container.
PORT=8080

# Folder with the built frontend. Empty runs the service API-only.
# `npm start` sets frontend/dist and the Docker image sets /app/web.
STATIC_DIR=

# Log verbosity: debug, info, warn or error.
LOG_LEVEL=info

# Log format: json for machines, text for reading in a terminal.
LOG_FORMAT=json

# Token bucket refill rate per client for /api/ routes. 0 turns the limiter off.
RATE_LIMIT_PER_MINUTE=60

# Token bucket size, which is how many requests a client can send in one burst.
RATE_LIMIT_BURST=20

# true reads the client address from the first X-Forwarded-For entry. Set it only behind a proxy you control.
TRUST_PROXY=false

# Comma-separated origins allowed to call the API from a browser, such as https://app.example.com.
# Empty sends no CORS headers. The bundled frontend is same-origin and needs no entry.
CORS_ALLOWED_ORIGINS=
